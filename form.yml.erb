---
cluster: "pax"

bc_dynamic_js: true

form:
  - disclaimer_block
  - bc_num_hours
  - num_cores
  - num_memory
  - partition
  - gpu_type
  - version
  - outdir
  - modelroot
  - ta_qos

attributes:
<%= File.read("/etc/ood/config/apps/dashboard/batch_connect/partials/ai_tools.yml").indent(2) %>

  disclaimer_block:
    widget: text_field
    class: "d-none"
    skip_label: true
<% if File.exist?("/etc/ood/config/apps/dashboard/batch_connect/partials/ai_disclaimer.md")  %>
    help: |
<%= File.read("/etc/ood/config/apps/dashboard/batch_connect/partials/ai_disclaimer.md").indent(11) %>
<% end %>

  version:
    label: Version
    widget: select
    options:
      - ["1.10.1"]

  outdir:
    label: Output directory
    widget: path_selector
    directory: /cluster/tufts
    required: true
    favorites:
      - /cluster/tufts
      - /cluster/home

  modelroot:
    label: Model root directory
    widget: path_selector
    value: "/cluster/tufts/hpc/tools/stable-diffusion-webui/models"
    directory: /cluster/tufts
    favorites:
      - /cluster/tufts
      - /cluster/home
    help: |
      Select the root directory that contains your Stable Diffusion models.

      Recommended organization under this directory:

      - `Stable-diffusion/`: checkpoint models (`.ckpt`, `.safetensors`)
      - `ControlNet/`: ControlNet models
      - `Lora/`: LoRA models
      - `ESRGAN/`: upscaling models
      - `GFPGAN/`: face restoration models
      - `Codeformer/`: face restoration models

      Example layout:

      - `/cluster/tufts/hpc/tools/stable-diffusion-webui/models/Stable-diffusion`
      - `/cluster/tufts/hpc/tools/stable-diffusion-webui/models/ControlNet`
      - `/cluster/tufts/hpc/tools/stable-diffusion-webui/models/Lora`
      - `/cluster/tufts/hpc/tools/stable-diffusion-webui/models/ESRGAN`

      A shared collection of commonly used checkpoint models is available under:
      `/cluster/tufts/hpc/tools/stable-diffusion-webui/models/Stable-diffusion`

      If you provide your own model root, please keep the same subfolder structure so the web UI can find models correctly.

  ta_qos:
    widget: check_box
    label: "Request priority start"
    cacheable: false
    help: |
      Submits the job with `--qos=interactive` for higher scheduling priority, so it
      starts sooner. Intended for short, small sessions: while the box is checked, the
      resource fields above are automatically capped to the interactive QOS limits and
      a notice below lists them. Leave this box unchecked if your job needs more time
      or resources than those limits allow.
    value: "normal"
    checked_value: "interactive"
    unchecked_value: "normal"
