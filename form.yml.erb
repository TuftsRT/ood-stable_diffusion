<%
  show_qos = false
  qos_options = (`sacctmgr show assoc where user=#{ENV['USER']} format=qos%1000 --noheader --parsable2 `).split(",")

  if qos_options.include?("interactive")
    show_qos = true
  end
%>
---
cluster: "pax"

form:
  - bc_num_hours
  - num_cores
  - num_memory
  - partition
  - gpu_type 
  - version
  - outdir
  - modeldir
<% if show_qos  %>
  - ta_qos
<%end%>

attributes:
<%= File.read("/etc/ood/config/apps/dashboard/batch_connect/partials/ai_tools.yml").indent(2) %>

  version:
    label: Version
    widget: select
    options:
          - ["1.10.1"]

  outdir:
    label: Output directory
    widget: path_selector
    directory: /cluster/tufts
    required: true
    favorites:
      - /cluster/tufts
      - /cluster/home 

  modeldir:
    label: Model directory
    widget: path_selector
    value: "/cluster/tufts/hpc/tools/stable-diffusion-webui/models/Stable-diffusion"
    directory: /cluster/tufts
    favorites:
      - /cluster/tufts
      - /cluster/home 
    help: |
          A selection of commonly used models are available at `/cluster/tufts/hpc/tools/stable-diffusion-webui/models/Stable-diffusion`.  
          You may also provide your own model path if preferred.
  
  ta_qos:
    widget: check_box
    label: "Request priority start"
    help: "Limited to 1 running job at a time. (--qos=interactive)"
    value: "interactive"
    checked_value: "interactive"
    unchecked_value: "normal"
